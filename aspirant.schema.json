{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Aspirant",
  "type": "object",
  "required": ["full_name", "seat", "party_or_independent"],
  "properties": {
    "full_name": {"type": "string"},
    "photo_url": {"type": "string"},
    "party_or_independent": {"type": "string"},
    "seat": {"enum": ["Governor", "Woman Rep", "MP", "MCA"]},
    "constituency": {"type": "string"},
    "ward": {"type": "string"},
    "bio": {"type": "string", "maxLength": 900},
    "pledges": {"type": "array", "maxItems": 5, "items": {"type": "string"}},
    "manifesto_pdf_url": {"type": "string"},
    "track_record": {"type": "string"},
    "contact": {"type": "object", "properties": {"phone": {"type": "string"}, "email": {"type": "string"}, "social": {"type": "array", "items": {"type": "string"}}}},
    "events": {"type": "array", "items": {"type": "object"}},
    "intro_video_url": {"type": "string"},
    "verified": {"type": "boolean", "default": false}
  }
}
